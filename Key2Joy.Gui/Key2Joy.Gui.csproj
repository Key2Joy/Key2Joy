    <None Remove="obj\**" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Management" Version="9.0.14" />
    <PackageReference Include="System.Runtime.Handles" Version="4.3.0" />
    <PackageReference Include="ObjectListView.Repack.Core3" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Key2Joy.Core\Key2Joy.Core.csproj" />
    <ProjectReference Include="..\Key2Joy.Cmd\Key2Joy.Cmd.csproj" TreatAsUsed="true" />
  </ItemGroup>

