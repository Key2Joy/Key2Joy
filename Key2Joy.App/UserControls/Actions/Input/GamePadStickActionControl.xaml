<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Key2Joy.App.UserControls.Actions.Input.GamePadStickActionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Key2Joy.App.UserControls.Actions.Input"
    xmlns:gamepad="using:Key2Joy.Mapping.Triggers.GamePad"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Stick Side:"
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      SelectedItem="{x:Bind SelectedSide, Mode=TwoWay}"
                      ItemsSource="{x:Bind AvailableSides}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="gamepad:GamePadSide">
                        <TextBlock Text="{x:Bind Converter={StaticResource EnumToStringConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="GamePad Index:"
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      SelectedItem="{x:Bind SelectedGamePadIndex, Mode=TwoWay}"
                      ItemsSource="{x:Bind AvailableGamePadIndices}" />
        </Grid>

        <CheckBox Content="Use input scale (delta from stick input)"
                  IsChecked="{x:Bind IsInputMode, Mode=TwoWay}" />

        <!-- Input scale mode -->
        <StackPanel Spacing="4"
                    Visibility="{x:Bind IsInputMode, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Input Scale X:"
                           VerticalAlignment="Center"/>
                <NumberBox Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           SpinButtonPlacementMode="Inline"
                           SmallChange="0.1"
                           Value="{x:Bind InputScaleX, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Input Scale Y:"
                           VerticalAlignment="Center"/>
                <NumberBox Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           SpinButtonPlacementMode="Inline"
                           SmallChange="0.1"
                           Value="{x:Bind InputScaleY, Mode=TwoWay}" />
            </Grid>
        </StackPanel>

        <!-- Exact mode -->
        <StackPanel Spacing="4"
                    Visibility="{x:Bind IsExactMode, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Exact X:"
                           VerticalAlignment="Center"/>
                <NumberBox Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           SpinButtonPlacementMode="Inline"
                           Minimum="-32768"
                           Maximum="32767"
                           SmallChange="1"
                           Value="{x:Bind ExactX, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Exact Y:"
                           VerticalAlignment="Center"/>
                <NumberBox Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           SpinButtonPlacementMode="Inline"
                           Minimum="-32768"
                           Maximum="32767"
                           SmallChange="1"
                           Value="{x:Bind ExactY, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Reset After:"
                           VerticalAlignment="Center"/>
                <NumberBox Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           SpinButtonPlacementMode="Inline"
                           Minimum="0"
                           SmallChange="100"
                           Value="{x:Bind ResetAfterMs, Mode=TwoWay}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
