<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Key2Joy.App.UserControls.Actions.Input.GamePadActionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Key2Joy.App.UserControls.Actions.Input"
    xmlns:input="using:Key2Joy.LowLevelInput"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="GamePad Button:"
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      SelectedItem="{x:Bind SelectedButton, Mode=TwoWay}"
                      ItemsSource="{x:Bind AvailableButtons}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Press State:"
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      SelectedItem="{x:Bind SelectedPressState, Mode=TwoWay}"
                      ItemsSource="{x:Bind AvailablePressStates}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="input:PressState">
                        <TextBlock Text="{x:Bind Converter={StaticResource EnumToStringConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="GamePad Index:"
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      SelectedItem="{x:Bind SelectedGamePadIndex, Mode=TwoWay}"
                      ItemsSource="{x:Bind AvailableGamePadIndices}" />
        </Grid>
    </StackPanel>
</UserControl>
