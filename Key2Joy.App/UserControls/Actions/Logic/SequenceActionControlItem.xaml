<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Key2Joy.App.UserControls.Actions.Logic.SequenceActionControlItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:actions="using:Key2Joy.App.UserControls.Actions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8"
            Margin="0,4,0,4">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <actions:ActionControl x:Name="actionControl"
                                   HorizontalAlignment="Stretch" />

            <Grid Grid.Column="1"
                  ColumnSpacing="5"
                  RowSpacing="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Content="Remove"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Right"
                        Click="RemoveButton_Click" />
                
                <Button Click="MoveUpButton_Click"
                        Grid.Column="0"
                        Grid.Row="2">
                    <FontIcon Glyph="&#xE74A;" />
                </Button>

                <Button Click="MoveDownButton_Click"
                        Grid.Column="1"
                        Grid.Row="2">
                    <FontIcon Glyph="&#xE74B;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
