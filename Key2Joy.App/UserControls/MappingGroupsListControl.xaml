<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Key2Joy.App.UserControls.MappingGroupsListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Key2Joy.App.UserControls"
    xmlns:pages="using:Key2Joy.App.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <ItemsControl x:Name="MappingGroupsControl"
                          ItemsSource="{x:Bind FilteredMappingGroups}"
                          Margin="0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pages:MappingGroupViewModel">
                        <StackPanel>
                            <!-- Group header -->
                            <TextBlock Text="{x:Bind GroupName}"
                                       Visibility="{x:Bind IsHeaderVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                       FontWeight="SemiBold"
                                       Margin="12,8,10,2"
                                       Opacity="0.6"
                                       FontSize="11" />

                            <!-- Items in this group -->
                            <ItemsControl ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:MappedOptionViewModel">
                                        <StackPanel Margin="10,2">
                                            <!-- Parent row -->
                                            <Grid Tapped="MappingItem_Tapped"
                                                  DoubleTapped="MappingItem_DoubleTapped"
                                                  RightTapped="MappingItem_RightTapped"
                                                  PointerEntered="MappingItem_PointerEntered"
                                                  PointerExited="MappingItem_PointerExited"
                                                  CornerRadius="4"
                                                  Padding="10"
                                                  Tag="{x:Bind}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="50" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.ColumnSpan="4"
                                                        Margin="-10"
                                                        Background="{ThemeResource ListViewItemBackgroundPointerOver}"
                                                        Visibility="{x:Bind IsHovered, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                <Border Grid.ColumnSpan="4"
                                                        Margin="-10"
                                                        Background="{ThemeResource ListViewItemBackgroundSelected}"
                                                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                <Rectangle Grid.ColumnSpan="4"
                                                           Width="4"
                                                           Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Stretch"
                                                           RadiusX="2"
                                                           RadiusY="2"
                                                           Margin="-10,0,0,0"
                                                           Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Trigger}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="4,0,0,0" />

                                                <FontIcon Grid.Column="1"
                                                          Glyph="&#xE72A;"
                                                          FontSize="12"
                                                          Margin="10,0"
                                                          Opacity="0.5"
                                                          VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind Action}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />

                                                <!-- Expand/collapse chevron, only visible when there are children -->
                                                <ToggleButton Grid.Column="3"
                                                              Click="ExpandToggle_Click"
                                                              Visibility="{x:Bind HasChildren, Converter={StaticResource BoolToVisibilityConverter}}"
                                                              Background="Transparent"
                                                              BorderThickness="0"
                                                              Padding="5"
                                                              MinWidth="0"
                                                              MinHeight="0"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE96E;"
                                                              FontSize="12" />
                                                </ToggleButton>
                                            </Grid>

                                            <!-- Children panel, collapsed by default -->
                                            <ItemsControl ItemsSource="{x:Bind Children}"
                                                          Visibility="Collapsed"
                                                          Margin="28,5,0,5">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="pages:MappedOptionViewModel">
                                                        <Grid Tapped="MappingItem_Tapped"
                                                              DoubleTapped="MappingItem_DoubleTapped"
                                                              RightTapped="MappingItem_RightTapped"
                                                              PointerEntered="MappingItem_PointerEntered"
                                                              PointerExited="MappingItem_PointerExited"
                                                              CornerRadius="4"
                                                              Padding="10,10"
                                                              Tag="{x:Bind}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.ColumnSpan="3"
                                                                    Margin="-10"
                                                                    Background="{ThemeResource ListViewItemBackgroundPointerOver}"
                                                                    Visibility="{x:Bind IsHovered, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                            <Border Grid.ColumnSpan="3"
                                                                    Margin="-10"
                                                                    Background="{ThemeResource ListViewItemBackgroundSelected}"
                                                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                            <Rectangle Grid.ColumnSpan="3"
                                                                       Width="4"
                                                                       Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Stretch"
                                                                       RadiusX="2"
                                                                       RadiusY="2"
                                                                       Margin="-10,0,0,0"
                                                                       Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{x:Bind Trigger}"
                                                                       Foreground="{ThemeResource TextFillColorSecondary}"
                                                                       VerticalAlignment="Center" />

                                                            <FontIcon Grid.Column="1"
                                                                      Glyph="&#xE72A;"
                                                                      FontSize="10"
                                                                      Margin="10,0"
                                                                      Opacity="0.3"
                                                                      VerticalAlignment="Center" />

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{x:Bind Action}"
                                                                       Foreground="{ThemeResource TextFillColorSecondary}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Visibility="{x:Bind FilteredMappedOptionsCount, Mode=OneWay, Converter={StaticResource VisibleWhenZeroConverter}}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Opacity=".5"
                    Spacing="8">
            <FontIcon Glyph="&#xE71D;"
                      FontSize="32"
                      HorizontalAlignment="Center" />
            <TextBlock TextAlignment="Center"
                       FontSize="14">
                No mappings found.
            </TextBlock>
            <TextBlock TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="220">
                Add a mapping using the panel below, or clear your search.
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
