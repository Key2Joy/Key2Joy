<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Key2Joy.App.UserControls.Triggers.GamePad.GamePadTriggerTriggerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Key2Joy.App.UserControls.Triggers.GamePad"
    xmlns:gamepad="using:Key2Joy.Mapping.Triggers.GamePad"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Trigger Side:"
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      SelectedItem="{x:Bind SelectedTriggerSide, Mode=TwoWay}"
                      ItemsSource="{x:Bind AvailableTriggerSides}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="gamepad:GamePadSide">
                        <TextBlock Text="{x:Bind Converter={StaticResource EnumToStringConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="GamePad Index:"
                       VerticalAlignment="Center"/>
            <NumberBox Grid.Column="1"
                       HorizontalAlignment="Stretch"
                       SpinButtonPlacementMode="Inline"
                       Minimum="0"
                       Maximum="3"
                       SmallChange="1"
                       Value="{x:Bind GamePadIndex, Mode=TwoWay}" />
        </Grid>

        <CheckBox Content="Override deadzone"
                  IsChecked="{x:Bind OverrideDeadzone, Mode=TwoWay}" />

        <StackPanel Spacing="8"
                    Visibility="{x:Bind OverrideDeadzone, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Deadzone (0-1):"
                           VerticalAlignment="Center"/>
                <NumberBox Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           SpinButtonPlacementMode="Inline"
                           Minimum="0"
                           Maximum="1"
                           SmallChange="0.1"
                           Value="{x:Bind Deadzone, Mode=TwoWay}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
