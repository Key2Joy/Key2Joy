<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Key2Joy.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Key2Joy.App"
    xmlns:utils="using:Key2Joy.App.Utils"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <toolkit:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <toolkit:BoolNegationConverter x:Key="BoolNegationConverter" />
            <utils:StringToBoolConverter x:Key="StringToBoolConverter" />
            <utils:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <utils:EnumToStringConverter x:Key="EnumToStringConverter" />
            <utils:VisibleWhenZeroConverter x:Name="VisibleWhenZeroConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
