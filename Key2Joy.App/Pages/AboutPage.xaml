<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Key2Joy.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Key2Joy.App.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32">

        <StackPanel MaxWidth="900"
                    HorizontalAlignment="Center">

            <!-- Header: Logo + Product Info side by side -->
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/Assets/Icons/icon256.png"
                       Width="256"
                       Height="256"
                       Stretch="Uniform"
                       VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock x:Name="ProductNameTextBlock"
                               Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock x:Name="VersionTextBlock"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="CopyrightTextBlock"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Margin="0,4,0,0" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,12,0,0">
                        <HyperlinkButton Content="GitHub"
                                         NavigateUri="https://github.com/luttje/Key2Joy"
                                         Padding="8,4" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Rectangle Height="1"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       Margin="0,4" />

            <!-- Credits Section -->
            <StackPanel Spacing="12"
                        Padding="32">
                <TextBlock Text="Additional Credits"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="The following people are thanked for their open-source projects. This software wouldn't exist without their generosity."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Credits cards -->
                <ItemsControl x:Name="CreditsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Note -->
                <TextBlock Text="If someone is missing from this list, please do let us know on GitHub."
                           TextWrapping="Wrap"
                           FontStyle="Italic"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
