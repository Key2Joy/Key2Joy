<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Key2Joy.App.Pages.MainMappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Key2Joy.App.Pages"
    xmlns:mapping="using:Key2Joy.Mapping"
    xmlns:input="using:Key2Joy.LowLevelInput"
    xmlns:controls="using:Key2Joy.App.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Section -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search and Profile -->
                <Grid Padding="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Padding="10,0"
                                Spacing="10">
                        <Image Source="/Assets/Icons/magnifier.png"
                               Height="16"/>
                        <TextBlock VerticalAlignment="Center">
                            Search
                        </TextBlock>
                    </StackPanel>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="1"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal"
                                Grid.Column="2"
                                Padding="40,0,10,0"
                                Spacing="10">
                        <Image Source="/Assets/Icons/text_list_bullets.png"
                               Height="16"/>
                        <TextBlock VerticalAlignment="Center">
                            Profile
                        </TextBlock>
                    </StackPanel>

                    <TextBox x:Name="ProfileNameTextBox"
                             Grid.Column="3"
                             Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Mappings List -->
                <ListView x:Name="MappingListView"
                          Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.FilteredMappedOptions}"
                          SelectionMode="Single"
                          SelectionChanged="MappingListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="mapping:MappedOption">
                            <StackPanel Orientation="Vertical"
                                        Spacing="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                           Text="{x:Bind Trigger}"
                                           Margin="5,15,5,0" />

                                    <TextBlock Grid.Column="1"
                                           Text="{x:Bind Action}"
                                           Margin="5,15,5,0" />
                                </Grid>

                                <ListView Grid.Column="0"
                                          Padding="25,0,0,15"
                                          SelectionMode="Single"
                                          ItemsSource="{x:Bind Children}"
                                          SelectionChanged="MappingListView_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="mapping:MappedOption">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Trigger}"
                                                           Foreground="{ThemeResource TextFillColorDisabled}"
                                                           Margin="5" />

                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Action}"
                                                           Foreground="{ThemeResource TextFillColorDisabled}"
                                                           Margin="5" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Connect & Devices List -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10"
                      Padding="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Connect when untoggled, disconnect when toggled -->
                    <ToggleButton x:Name="ArmedToggleButton"
                                  HorizontalAlignment="Stretch"
                                  IsChecked="{x:Bind ViewModel.Armed, Mode=TwoWay}"
                                  Content="{x:Bind ViewModel.ArmedButtonText, Mode=OneWay}"/>

                    <!-- Refresh Button -->
                    <Button Grid.Column="1">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center"
                           Margin="5"
                           Text="{x:Bind ViewModel.ArmErrorMessage, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.ArmErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                           Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}" />

                <!-- Devices List -->
                <ListView Grid.Row="1"
                          Padding="5"
                          SelectionMode="None"
                          ItemsSource="{x:Bind ViewModel.Devices}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="input:IGamePadInfo">
                            <StackPanel Orientation="Vertical"
                                        Spacing="5"
                                        Margin="10">
                                <controls:DeviceControl DeviceIndex="{x:Bind Index}"
                                                        DeviceName="{x:Bind Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <controls:MappingControl x:Name="MappingControl"
                                 Grid.Row="1"
                                 Height="260" />
    </Grid>
</Page>
